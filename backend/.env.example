PORT=8080
DATABASE_URL=postgres://eggfarm:eggfarm@localhost:5432/eggfarm?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# 421614 = Arbitrum Sepolia (default if unset). Set to 31337 when pointing RPC_URL at a local
# `anvil` node for development.
CHAIN_ID=421614
# Block the contracts were deployed at -- indexers start scanning here instead of from genesis.
# Leave 0 for a fresh local Anvil chain; use the real deploy block for a testnet/mainnet target.
DEPLOY_BLOCK=0

# From `forge script script/Deploy.s.sol` output.
FEED_TOKEN_ADDRESS=
EGG_NFT_ADDRESS=
CREATURE_NFT_ADDRESS=
MARKETPLACE_ADDRESS=

# Backend hot wallet with MINTER_ROLE (FeedToken) and GAME_CONTROLLER_ROLE (EggNFT), and enough
# Arbitrum Sepolia ETH to sponsor checkStarvation/checkEggCare/mintReward gas. Never commit the
# real value.
BACKEND_SIGNER_PRIVATE_KEY=

# Real ARB governance token contract (activates the arb_token_holder/arb_token_received
# ecosystem tasks). Arbitrum One: 0x912CE59144191C1204E64559FE8253a0e49E6548. Leave blank on
# networks where ARB isn't deployed (Arbitrum Sepolia, local Anvil) -- those tasks just stay
# inactive rather than silently checking the wrong address.
ARB_TOKEN_ADDRESS=

# Run cmd/worker's background jobs inside cmd/server (single-instance hosts like Render free).
# Leave unset when running cmd/worker separately, or every job runs twice.
# RUN_WORKER=true
# Apply migrations/*.sql on server startup. Only for a database created empty (e.g. a new
# Supabase project) -- the docker-compose database already has them applied.
# AUTO_MIGRATE=true
