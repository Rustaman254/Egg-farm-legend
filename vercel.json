{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "webapp": {
      "root": "webapp",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "webapp" } }
  ]
}
